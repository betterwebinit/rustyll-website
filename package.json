{
  "name": "rustyll-website",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i assets/css/input.css -o assets/css/generated.css --minify",
    "build": "npm run build:css && BUNDLE_PATH=vendor/bundle bundle exec jekyll build",
    "dev": "npm run build:css && BUNDLE_PATH=vendor/bundle bundle exec jekyll serve --host 127.0.0.1 --port 4001",
    "test": "node --test tests/*.test.cjs",
    "check:links": "python3 scripts/check_site.py",
    "social": "node scripts/render-social.cjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "@tailwindcss/typography": "0.5.16",
    "playwright": "1.58.2",
    "axe-core": "4.10.3"
  }
}
